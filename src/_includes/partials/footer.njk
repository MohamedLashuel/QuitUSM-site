<footer class="site-footer">
  <div class="footer container">
    <div class="footer__links">
      <a href="https://github.com/MohamedLashuel/QuitUSM-site" class="footer__icon-link" title="GitHub">
        {% icon "github", "footer__icon" %}
      </a>
      <a class="footer__icon-link" title="{{ site.discordLabel }} (coming soon)">
        {% icon "discord", "footer__icon" %}
        {{ site.discordLabel }}
      </a>
    </div>
    <div class="footer__contact">
      <p class="footer__heading">Contact</p>
      <a href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a>
    </div>
    <p class="footer__legal">&copy; {{ year }} {{ site.name }}. Released under the MIT License.</p>
  </div>
</footer>
