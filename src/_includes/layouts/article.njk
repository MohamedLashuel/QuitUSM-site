---
layout: layouts/base.njk
---
<article class="article container container--narrow">
  <header class="article__header">
    <h1 class="article__title">{{ title }}</h1>
    {% if showDate %}<p class="article__meta"><time datetime="{{ page.date.toISOString() }}">{{ page.date | readableDate }}</time></p>{% endif %}
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
</article>
